{
  "name": "norc",
  "version": "0.2.0",
  "description": "Manage norc cron jobs, machines, and run history from Claude Code via the norc MCP server.",
  "author": { "name": "norc" },
  "homepage": "https://norc.app",
  "license": "MIT",
  "mcpServers": {
    "norc": {
      "command": "npx",
      "args": ["-y", "norc-mcp"],
      "env": {
        "NORC_API_KEY": "${NORC_API_KEY}"
      }
    }
  }
}
